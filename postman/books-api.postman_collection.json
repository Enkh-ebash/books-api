{
  "info": {
    "name": "Books API",
    "description": "Проверка микросервиса «Библиотека». Запускать через Collection Runner сверху вниз.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Список авторов",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"массив\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/authors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "authors"
          ]
        }
      }
    },
    {
      "name": "3. Создать автора",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"authorId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Автор {{$timestamp}}\",\n  \"country\": \"Монголия\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/authors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "authors"
          ]
        }
      }
    },
